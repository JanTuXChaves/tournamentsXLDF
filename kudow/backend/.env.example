# ==========================================================
# CONFIGURAÇÕES DE PRODUÇÃO - KUDOW TORNEIOS BACKEND
# ==========================================================

# Ambiente de execução: development | production
# Em 'production':
# - SECRET_KEY torna-se obrigatória
# - /docs e /redoc são ocultados automaticamente
# - Simulação de pagamentos de teste fica bloqueada para usuários comuns
ENVIRONMENT=production

# Chave criptográfica JWT (gere com: openssl rand -hex 32)
SECRET_KEY= SUBSTITUA_POR_UMA_CHAVE_SECRETA_DE_64_CARACTERES_HEX

# Banco de Dados (PostgreSQL recomendado em produção)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/kudow_prod

# Origens permitidas no CORS separadas por vírgula
ALLOWED_ORIGINS=https://app.kudow.com.br,https://www.kudow.com.br

# Credenciais Oficiais do Mercado Pago
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_PUBLIC_KEY=APP_USR-00000000-0000-0000-0000-000000000000
MP_WEBHOOK_SECRET=SEGREDO_ASSINATURA_WEBHOOK_MERCADO_PAGO
